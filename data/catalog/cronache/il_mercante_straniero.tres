[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Resource" path="res://data/catalog/personaggi/mercante.tres" id="x3"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x4"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
oro = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x4")
label = "Concedi il banco"
description = "Entra nella storia un mercante; ricevi 2 Oro."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, 1, 0, 0)
introduce_character = ExtResource("x3")
character_affinity = 1
story = "{personaggio} aprì il suo banco nella piazza grande."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
oro = 4

[sub_resource type="Resource" id="S4"]
script = ExtResource("x4")
label = "Concedi, con una tassa pesante"
description = "Entra nella storia un mercante, scontento; ricevi 4 Oro."
gain = SubResource("S3")
inclination_shift = PackedInt32Array(0, 0, 0, 1)
introduce_character = ExtResource("x3")
character_affinity = -1
story = "{personaggio} aprì il banco e pagò, maledicendo."

[sub_resource type="Resource" id="S5"]
script = ExtResource("x4")
label = "Mandalo via"
description = ""
inclination_shift = PackedInt32Array(0, -1, 0, 0)
story = "Il mercante ripartì con le sue casse."

[resource]
script = ExtResource("x1")
id = &"il_mercante_straniero"
display_name = "Il mercante straniero"
description = "Un mercante dai porti lontani chiede il permesso di aprire un banco nella capitale di {nazione}."
sphere = "Oro"
color = &"energetico"
seasons = PackedInt32Array(1, 2)
options = Array[ExtResource("x4")]([SubResource("S2"), SubResource("S4"), SubResource("S5")])
min_year = 2
