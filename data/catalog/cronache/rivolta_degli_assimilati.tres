[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
label = "Reprimi"
description = "Il Malcontento scende di 1."
malcontent_change = -1
inclination_shift = PackedInt32Array(1, 0, 0, 1)
story = "La rivolta fu soffocata nel sangue."

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
oro = 2

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
label = "Concedi diritti"
description = "Paghi 2 Oro; il Malcontento scende di 2."
cost = SubResource("S2")
malcontent_change = -2
inclination_shift = PackedInt32Array(0, 1, 0, -1)
story = "Gli assimilati ebbero diritti, e un nome nuovo."

[resource]
script = ExtResource("x1")
id = &"rivolta_degli_assimilati"
display_name = "La rivolta degli assimilati"
description = "Gli assimilati si sono ribellati: chiedono di tornare quello che erano."
sphere = "Stato"
color = &"blu"
min_malcontent = 3
options = Array[ExtResource("x2")]([SubResource("S1"), SubResource("S3")])
requires_flags = Array[StringName]([&"assimilati"])
