[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
documenti = 2
oro = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Tollera, in cambio di una parte"
description = "Ricevi 2 Documenti e 1 Oro."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, 0, 0, -1)
story = "I ladri pagarono la loro parte, e nessuno li disturbò."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Una grande retata"
description = "Il Malcontento sale di 1."
malcontent_change = 1
inclination_shift = PackedInt32Array(0, 0, 0, 2)
story = "La grande retata riempì le galere."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
ferro = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Arruola i migliori"
description = "Ricevi 1 Ferro."
gain = SubResource("S4")
inclination_shift = PackedInt32Array(1, 0, 0, -1)
story = "I tagliagole migliori ebbero una divisa."

[resource]
script = ExtResource("x1")
id = &"citta_dei_ladri"
display_name = "La città dei ladri"
description = "Nei vicoli di {nazione} c'è più legge dei ladri che legge dello Stato."
sphere = "Ombra"
color = &"viola"
requires_types = Array[StringName]([&"Criminale"])
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S5")])
min_type_count = 3
