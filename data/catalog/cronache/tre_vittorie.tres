[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
label = "Celebra il trionfo"
description = "Il Malcontento scende di 1."
malcontent_change = -1
inclination_shift = PackedInt32Array(2, 0, 0, 0)
story = "Il trionfo durò sette giorni."

[sub_resource type="Resource" id="S2"]
script = ExtResource("x2")
label = "Resta umile"
description = ""
inclination_shift = PackedInt32Array(-1, 0, 1, 0)
story = "Si ringraziarono gli dei, a bassa voce."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
stabilita = 1

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
label = "Fai sfilare i prigionieri in catene"
description = "Ricevi 1 Stabilità."
gain = SubResource("S3")
inclination_shift = PackedInt32Array(1, -1, 0, 0)
story = "I prigionieri sfilarono in catene sotto gli sputi della folla."

[resource]
script = ExtResource("x1")
id = &"tre_vittorie"
display_name = "Tre vittorie di fila"
description = "Tre vittorie di fila. Per le strade si canta il nome di {nazione}, e qualcuno comincia a dire che il mondo è nostro."
sphere = "Guerra"
color = &"rosso"
seasons = PackedInt32Array(0, 2, 3)
options = Array[ExtResource("x2")]([SubResource("S1"), SubResource("S2"), SubResource("S4")])
min_win_streak = 3
