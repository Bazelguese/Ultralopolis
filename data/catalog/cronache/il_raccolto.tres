[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
cibo = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x2")
fede = 2

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "La decima al tempio"
description = "Paghi 1 Cibo, ricevi 2 Fede."
cost = SubResource("S1")
gain = SubResource("S2")
inclination_shift = PackedInt32Array(0, 0, 1, 0)
story = "Il primo grano andò agli dei."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
cibo = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
oro = 3

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Vendi l'eccedenza"
description = "Paghi 1 Cibo, ricevi 3 Oro."
cost = SubResource("S4")
gain = SubResource("S5")
inclination_shift = PackedInt32Array(0, 1, 0, 0)
story = "Il grano partì sulle navi dei mercanti."

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Riempi i magazzini dell'esercito"
description = ""
inclination_shift = PackedInt32Array(1, -1, 0, 0)
story = "Il grano fu chiuso nei magazzini militari."

[resource]
script = ExtResource("x1")
id = &"il_raccolto"
display_name = "Il raccolto"
description = "L'equinozio d'autunno porta il raccolto. Che cosa ne fa {nazione}?"
sphere = "Natura"
color = &"verde"
seasons = PackedInt32Array(3)
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S3"), SubResource("S6"), SubResource("S7")])
