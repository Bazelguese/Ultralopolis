[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
stabilita = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Pugno duro sulle risse"
description = "Ricevi 1 Stabilità."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, 0, 0, 1)
story = "Le guardie riempirono le prigioni."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Lascia sfogare il popolo"
description = "Il Malcontento scende di 1."
malcontent_change = -1
inclination_shift = PackedInt32Array(0, 0, 0, -1)
story = "Si lasciò che il popolo sfogasse la sua rabbia."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
pietra = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
cibo = 1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Scava nuovi pozzi"
description = "Paghi 1 Pietra, ricevi 1 Cibo."
cost = SubResource("S4")
gain = SubResource("S5")
inclination_shift = PackedInt32Array(0, -1, 0, 0)
story = "Si scavarono pozzi profondi, per non dover chiedere acqua a nessuno."

[resource]
script = ExtResource("x1")
id = &"la_calura"
display_name = "La calura"
description = "Un'estate feroce: fiumi bassi, animi accesi. Nelle piazze scoppiano risse."
sphere = "Natura"
color = &"verde"
seasons = PackedInt32Array(2)
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S6")])
