[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
stabilita = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Razionamento severo"
description = "Ricevi 1 Stabilità."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, 0, 0, 1)
story = "Ogni pagnotta fu contata e scritta."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
cibo = 1

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
label = "Apri i granai al popolo"
description = "Paghi 1 Cibo; il Malcontento scende di 1."
cost = SubResource("S3")
malcontent_change = -1
inclination_shift = PackedInt32Array(0, 0, 0, -1)
story = "I granai si aprirono e il popolo mangiò."

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
oro = 3

[sub_resource type="Resource" id="S6"]
script = ExtResource("x2")
cibo = 2

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Compra grano dagli stranieri"
description = "Paghi 3 Oro, ricevi 2 Cibo."
cost = SubResource("S5")
gain = SubResource("S6")
inclination_shift = PackedInt32Array(0, 1, 0, 0)
story = "Le navi straniere portarono grano in pieno inverno."

[resource]
script = ExtResource("x1")
id = &"conti_dell_inverno"
display_name = "I conti dell'inverno"
description = "I granai di {nazione} sono mezzi vuoti e gli scribi portano i registri dell'anno."
sphere = "Stato"
color = &"blu"
seasons = PackedInt32Array(0)
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S4"), SubResource("S7")])
