[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
stabilita = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Proibisci la loro lingua"
description = "Ricevi 1 Stabilità."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, -1, 0, 1)
story = "La lingua dei vinti fu proibita."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Lasciali cantare"
description = ""
inclination_shift = PackedInt32Array(0, 1, 0, 0)
story = "I canti dei vinti entrarono nelle feste di {nazione}."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
fede = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Convertili alla nostra fede"
description = "Paghi 1 Fede; il Malcontento scende di 1."
cost = SubResource("S4")
malcontent_change = -1
inclination_shift = PackedInt32Array(0, 0, 1, 0)
story = "Gli assimilati furono battezzati, uno per uno."

[resource]
script = ExtResource("x1")
id = &"gli_assimilati"
display_name = "Gli assimilati"
description = "Gli assimilati lavorano nei campi di {nazione}, ma di notte cantano nella loro lingua."
sphere = "Stato"
color = &"blu"
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S5")])
requires_flags = Array[StringName]([&"assimilati"])
