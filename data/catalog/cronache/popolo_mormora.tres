[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
label = "Reprimi"
description = "Il Malcontento scende di 1."
malcontent_change = -1
inclination_shift = PackedInt32Array(0, -1, 0, 1)
story = "Le guardie entrarono nelle taverne di notte."

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
oro = 3

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
label = "Ascolta le richieste"
description = "Paghi 3 Oro; il Malcontento scende di 2."
cost = SubResource("S2")
malcontent_change = -2
inclination_shift = PackedInt32Array(0, 0, 0, -1)
story = "Il governo ascoltò le piazze, e pagò."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
label = "Lascia correre"
description = ""
inclination_shift = PackedInt32Array(0, 0, 0, -1)
story = "Si lasciarono le scritte sui muri."

[resource]
script = ExtResource("x1")
id = &"popolo_mormora"
display_name = "Il popolo mormora"
description = "Nelle taverne si parla male del governo di {nazione}. Qualcuno ha scritto parole d'odio sui muri."
sphere = "Stato"
color = &"blu"
min_malcontent = 4
repeatable = true
options = Array[ExtResource("x2")]([SubResource("S1"), SubResource("S3"), SubResource("S4")])
