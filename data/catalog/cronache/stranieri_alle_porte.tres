[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
legno = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Accoglili"
description = "Ricevi 1 Legno; il Malcontento sale di 1."
gain = SubResource("S1")
malcontent_change = 1
inclination_shift = PackedInt32Array(0, 2, 0, 0)
story = "I profughi entrarono e costruirono case fuori dalle mura."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Respingili"
description = ""
inclination_shift = PackedInt32Array(0, -2, 0, 0)
story = "Le porte restarono chiuse e la carovana ripartì."

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
ferro = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Prendi i forti, respingi i deboli"
description = "Ricevi 1 Ferro."
gain = SubResource("S4")
inclination_shift = PackedInt32Array(1, -1, 0, 0)
story = "Entrarono solo quelli che potevano combattere."

[resource]
script = ExtResource("x1")
id = &"stranieri_alle_porte"
display_name = "Stranieri alle porte"
description = "Una carovana di profughi chiede di entrare in {nazione}: fuggono da una guerra lontana."
sphere = "Stato"
color = &"blu"
seasons = PackedInt32Array(1, 2)
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S5")])
