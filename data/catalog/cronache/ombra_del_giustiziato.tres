[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
oro = 4

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Paga per la pace"
description = "Paghi 4 Oro."
cost = SubResource("S4")
inclination_shift = PackedInt32Array(-1, 0, 0, 0)
clear_flags = Array[StringName]([&"prigioniero_giustiziato"])
story = "Il sangue fu pagato con l'oro."

[sub_resource type="Resource" id="S6"]
script = ExtResource("x4")
display_name = "Bande ai confini"
description = "−5 Resistenza nel prossimo scontro con il fantasma."
is_malus = true
effect = 6
amount = -5
duration_kind = 1

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Lasciali venire"
description = "−5 Resistenza nel prossimo scontro con il fantasma."
modifiers = Array[ExtResource("x4")]([SubResource("S6")])
