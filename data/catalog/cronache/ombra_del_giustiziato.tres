story = "Le bande bruciarono i villaggi di confine."

[resource]
script = ExtResource("x1")
id = &"ombra_del_giustiziato"
display_name = "L'ombra del giustiziato"
description = "Il popolo del prigioniero giustiziato non ha dimenticato. Ai confini compaiono bande che portano il suo nome."
sphere = "Guerra"
color = &"rosso"
options = Array[ExtResource("x3")]([SubResource("S3"), SubResource("S5"), SubResource("S7")])
requires_flags = Array[StringName]([&"prigioniero_giustiziato"])
