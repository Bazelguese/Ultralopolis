[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
ferro = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Giochi di guerra"
description = "Ricevi 1 Ferro."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(1, 0, 0, 0)
story = "Si festeggiò con giostre e duelli fino al sangue."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
oro = 2

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
label = "Fiera degli stranieri"
description = "Ricevi 2 Oro."
gain = SubResource("S3")
inclination_shift = PackedInt32Array(0, 1, 0, 0)
story = "Mercanti di dieci paesi riempirono le piazze."

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
fede = 1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Riti nei templi"
description = "Ricevi 1 Fede."
gain = SubResource("S5")
inclination_shift = PackedInt32Array(0, 0, 1, 0)
story = "I templi restarono aperti giorno e notte."

[resource]
script = ExtResource("x1")
id = &"giorno_piu_lungo"
display_name = "La festa del giorno più lungo"
description = "Nel solstizio d'estate {nazione} si ferma per tre giorni. Come vuoi che si festeggi?"
sphere = "Stato"
color = &"blu"
seasons = PackedInt32Array(2)
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S4"), SubResource("S6")])
