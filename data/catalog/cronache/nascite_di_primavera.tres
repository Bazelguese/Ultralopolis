[gd_resource type="Resource" script_class="ChronicleDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/chronicle_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
fede = 1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Un segno degli dei"
description = "Ricevi 1 Fede."
gain = SubResource("S1")
inclination_shift = PackedInt32Array(0, 0, 1, 0)
story = "Le culle furono benedette nei templi."

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
legno = 1

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
label = "Più braccia per lo Stato"
description = "Ricevi 1 Legno."
gain = SubResource("S3")
inclination_shift = PackedInt32Array(0, 0, 0, 1)
story = "Ogni neonato fu scritto nei registri dello Stato."

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Solo bocche da sfamare"
description = ""
inclination_shift = PackedInt32Array(0, 0, -1, 0)
story = "Le culle restarono senza benedizione."

[resource]
script = ExtResource("x1")
id = &"nascite_di_primavera"
display_name = "Le nascite di primavera"
description = "È una primavera di molte nascite. Le levatrici di {nazione} dicono che è un segno."
sphere = "Natura"
color = &"verde"
seasons = PackedInt32Array(1)
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S4"), SubResource("S5")])
