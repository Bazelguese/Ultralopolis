[resource]
script = ExtResource("1_opp")
id = &"incanto_danno"
display_name = "Incanto: furia"
description = "Una truppa a tua scelta ottiene per sempre +2/4/6 danno a ogni attivazione (secondo l'era della truppa; sale con il livello) e chiede 2 mana in più: dello stesso colore che usa già, oppure rosso se prima non chiedeva mana. Ogni truppa si incanta una volta sola (due con Seconda natura)."
kind = 8
cost_resources = SubResource("Resource_cost")
