[resource]
script = ExtResource("x1")
id = &"incanto_morso_del_nulla"
display_name = "Incanto: morso del nulla"
description = "Esclusivo del Culto del vuoto. Una truppa a tua scelta ottiene per sempre +1/2/3 Corruzione inflitta e +1/2/3 s di Sabotaggio a ogni attivazione (secondo l'era della truppa; sale con il livello); se prima non sabotava, sabota una truppa nemica a caso. Chiede 2 mana in più: dello stesso colore che usa già, oppure viola se prima non chiedeva mana. Ogni truppa si incanta una volta sola (due con Seconda natura)."
