[resource]
script = ExtResource("x1")
id = &"incanto_linfa"
display_name = "Incanto: linfa degli spiriti"
description = "Esclusivo degli Spiriti dei luoghi. Una truppa a tua scelta ottiene per sempre +2/4/6 cura e +1/2/3 s di Inefficienza a ogni attivazione (secondo l'era della truppa; sale con il livello): rende inefficiente una truppa nemica a caso. Chiede 2 mana in più: dello stesso colore che usa già, oppure blu se prima non chiedeva mana. Ogni truppa si incanta una volta sola (due con Seconda natura)."
kind = 8
cost_resources = SubResource("S1")
enchant_value = 2
enchant_amounts = PackedInt32Array(2, 4, 6)
enchant_color = &"blu"
enchant_value_2 = 5
enchant_amounts_2 = PackedInt32Array(1000, 2000, 3000)
