[resource]
script = ExtResource("x1")
id = &"incanto_scudo_degli_avi"
display_name = "Incanto: scudo degli avi"
description = "Esclusivo del Culto degli antenati. Una truppa a tua scelta ottiene per sempre +2/4/6 scudo a ogni attivazione, 3/6/9 se prima non chiedeva mana (secondo l'era della truppa; sale con il livello). Chiede 2 mana in più: dello stesso colore che usa già, oppure blu se prima non chiedeva mana. Ogni truppa si incanta una volta sola (due con Seconda natura)."
kind = 8
cost_resources = SubResource("S1")
enchant_value = 1
enchant_amounts = PackedInt32Array(2, 4, 6)
enchant_color = &"blu"
enchant_no_mana_bonus_percent = 50
