[resource]
script = ExtResource("1_opp")
id = &"incanto_inefficienza"
display_name = "Incanto: torpore"
description = "Una truppa a tua scelta ottiene per sempre +2/4/6 s di Inefficienza a ogni attivazione (secondo l'era della truppa; sale con il livello): rende inefficiente una truppa nemica a caso. Chiede 2 mana in più: dello stesso colore che usa già, oppure viola se prima non chiedeva mana. Ogni truppa si incanta una volta sola (due con Seconda natura)."
kind = 8
cost_resources = SubResource("Resource_cost")
enchant_value = 5
enchant_amounts = PackedInt32Array(2000, 4000, 6000)
enchant_color = &"viola"
