[gd_resource type="Resource" script_class="OpportunityDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/opportunity_def.gd" id="1_opp"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="2_ra"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="3_mod"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/censimento.tres" id="4_m"]

[sub_resource type="Resource" id="Resource_cost"]
script = ExtResource("2_ra")
stabilita = 2

[resource]
script = ExtResource("1_opp")
id = &"censimento"
display_name = "Censimento"
description = "Fino alla fine dell'anno ogni consigliere mostra un'opportunità in più."
kind = 5
cost_resources = SubResource("Resource_cost")
modifiers = Array[ExtResource("3_mod")]([ExtResource("4_m")])
