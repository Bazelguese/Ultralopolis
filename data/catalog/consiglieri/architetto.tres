[gd_resource type="Resource" script_class="AdvisorDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/advisor_def.gd" id="1_advdf"]
[ext_resource type="Script" path="res://scripts/sim/data/opportunity_def.gd" id="2_opp"]
[ext_resource type="Resource" path="res://data/catalog/opportunities/architetti.tres" id="act_0"]
[ext_resource type="Resource" path="res://data/catalog/opportunities/fortificazioni.tres" id="act_1"]

[resource]
script = ExtResource("1_advdf")
