[resource]
script = ExtResource("13_clnc3")
id = &"via_della_guerra"
display_name = "Via della Guerra"
description = "Le truppe Fante ricaricano il 10% più in fretta; il Generale e la sua azione Addestramento più frequenti. Bonus immediato: +1 spazio truppa."
dimension = 5
extra_troop_slots = 1
favored_opportunities = Array[ExtResource("2_fidwm")]([ExtResource("10_4q663")])
exclusive_troops = Array[ExtResource("3_bsbpn")]([ExtResource("4_d4vqu"), ExtResource("5_xoo1y")])
favored_by = Array[Resource]([ExtResource("6_ine2h"), ExtResource("7_18q52"), ExtResource("8_ma60e")])
permanent_modifiers = Array[ExtResource("11_sk6kw")]([ExtResource("12_e8xyd")])
traditions = Array[ExtResource("tr_trad")]([SubResource("tr_step_veterani_tradizione"), SubResource("tr_step_arsenali"), SubResource("tr_step_dottrina"), SubResource("tr_step_esercito_di_popolo")])
