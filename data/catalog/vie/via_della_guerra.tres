[sub_resource type="Resource" id="tr_deed_veterani_tradizione"]
script = ExtResource("tr_deed")
kind = 0
amount = 2

[sub_resource type="Resource" id="tr_mod_veterani_tradizione"]
script = ExtResource("tr_mod")
id = &"trad_veterani_tradizione"
display_name = "Veterani"
description = "Le truppe Fante che fanno danno ne fanno 1 in più."
is_malus = false
effect = 11
target_type = &"Fante"
battle_value = 0
amount = 1
duration_kind = 2
stacking = 1

[sub_resource type="Resource" id="tr_step_veterani_tradizione"]
script = ExtResource("tr_trad")
id = &"veterani_tradizione"
display_name = "Veterani"
description = "Le truppe Fante che fanno danno ne fanno 1 in più."
deed = SubResource("tr_deed_veterani_tradizione")
permanent_modifiers = Array[ExtResource("tr_mod")]([SubResource("tr_mod_veterani_tradizione")])

