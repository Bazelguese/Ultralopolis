[resource]
script = ExtResource("10_kx25f")
id = &"via_degli_spiriti"
display_name = "Via degli Spiriti"
description = "Esclusiva di chi segue gli Spiriti dei luoghi. +1 Cibo per fase da ogni edificio Fauna o di Produzione; Esattori più frequenti. Bonus: +4 Legno."
