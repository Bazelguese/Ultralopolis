[sub_resource type="Resource" id="tr_deed_legati"]
script = ExtResource("tr_deed")
kind = 0
amount = 2

[sub_resource type="Resource" id="tr_step_legati"]
script = ExtResource("tr_trad")
id = &"legati"
display_name = "Legati"
description = "+1 spazio edificio."
deed = SubResource("tr_deed_legati")
extra_building_slots = 1

[sub_resource type="Resource" id="tr_deed_strade"]
script = ExtResource("tr_deed")
kind = 4
amount = 2
types = Array[StringName]([&"Infrastruttura Strategica"])
pieces = 1

[sub_resource type="Resource" id="tr_mod_strade"]
script = ExtResource("tr_mod")
id = &"trad_strade"
display_name = "Strade"
description = "+1 Pietra per stagione da ogni edificio Infrastruttura Strategica."
is_malus = false
effect = 8
target_type = &"Infrastruttura Strategica"
resource = 4
amount = 1
duration_kind = 2
stacking = 1

[sub_resource type="Resource" id="tr_step_strade"]
script = ExtResource("tr_trad")
id = &"strade"
display_name = "Strade"
description = "+1 Pietra per stagione da ogni edificio Infrastruttura Strategica."
deed = SubResource("tr_deed_strade")
permanent_modifiers = Array[ExtResource("tr_mod")]([SubResource("tr_mod_strade")])

[sub_resource type="Resource" id="tr_deed_legioni"]
