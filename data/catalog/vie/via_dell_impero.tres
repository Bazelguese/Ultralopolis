[resource]
script = ExtResource("11_n3f3e")
id = &"via_dell_impero"
display_name = "Via dell'Impero"
description = "+10 Resistenza in ogni scontro; il Generale e la sua azione Quartiermastro più frequenti. Bonus immediato: +1 spazio truppa, +1 spazio edificio."
dimension = 5
extra_building_slots = 1
extra_troop_slots = 1
favored_opportunities = Array[ExtResource("2_ejdwo")]([ExtResource("7_gjige")])
exclusive_troops = Array[ExtResource("3_hmns4")]([ExtResource("4_aag50")])
favored_by = Array[Resource]([ExtResource("5_s24lc"), ExtResource("6_144ty")])
permanent_modifiers = Array[ExtResource("9_e82xv")]([ExtResource("10_qpw5x")])
traditions = Array[ExtResource("tr_trad")]([SubResource("tr_step_legati"), SubResource("tr_step_strade"), SubResource("tr_step_legioni"), SubResource("tr_step_pax")])
