[sub_resource type="Resource" id="tr_deed_botteghe"]
script = ExtResource("tr_deed")
kind = 2
amount = 3
advisor_id = &"tesoriere"
advisor_name = "Tesoriere"

[sub_resource type="Resource" id="tr_mod_botteghe"]
script = ExtResource("tr_mod")
id = &"trad_botteghe"
display_name = "Botteghe"
description = "+1 Oro per stagione dalla Capitale."
is_malus = false
effect = 8
target_type = &"Capitale"
resource = 0
amount = 1
duration_kind = 2
stacking = 1

[sub_resource type="Resource" id="tr_step_botteghe"]
script = ExtResource("tr_trad")
id = &"botteghe"
display_name = "Botteghe"
description = "+1 Oro per stagione dalla Capitale."
deed = SubResource("tr_deed_botteghe")
permanent_modifiers = Array[ExtResource("tr_mod")]([SubResource("tr_mod_botteghe")])

[sub_resource type="Resource" id="tr_deed_carovane"]
