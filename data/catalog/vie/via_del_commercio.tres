[resource]
script = ExtResource("13_c7dkq")
id = &"via_del_commercio"
display_name = "Via del Commercio"
description = "+1 Oro per stagione da ogni edificio Economico; il Tesoriere e la sua azione Esattori più frequenti. Bonus immediato: +6 Oro."
dimension = 5
extra_gold = 6
favored_opportunities = Array[ExtResource("4_mkm4t")]([ExtResource("10_cg87v")])
exclusive_buildings = Array[ExtResource("1_xm7k1")]([ExtResource("2_gq2ts"), ExtResource("3_c86x7")])
favored_by = Array[Resource]([ExtResource("6_kp1h6"), ExtResource("7_k2cpf"), ExtResource("8_iu28t")])
permanent_modifiers = Array[ExtResource("11_0jwc7")]([ExtResource("12_3ir5u")])
favored_advisors = Array[ExtResource("adv_s")]([ExtResource("adv_tes")])
traditions = Array[ExtResource("tr_trad")]([SubResource("tr_step_botteghe"), SubResource("tr_step_carovane"), SubResource("tr_step_fiere_annuali"), SubResource("tr_step_gilde")])
