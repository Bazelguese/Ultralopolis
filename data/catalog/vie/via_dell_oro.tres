[sub_resource type="Resource" id="tr_deed_zecche"]
script = ExtResource("tr_deed")
kind = 2
amount = 3
advisor_id = &"tesoriere"
advisor_name = "Tesoriere"

[sub_resource type="Resource" id="tr_mod_zecche"]
script = ExtResource("tr_mod")
id = &"trad_zecche"
display_name = "Zecche"
description = "+2 Oro per stagione dalla Capitale."
is_malus = false
effect = 8
target_type = &"Capitale"
resource = 0
amount = 2
duration_kind = 2
stacking = 1

[sub_resource type="Resource" id="tr_step_zecche"]
script = ExtResource("tr_trad")
id = &"zecche"
display_name = "Zecche"
description = "+2 Oro per stagione dalla Capitale."
deed = SubResource("tr_deed_zecche")
permanent_modifiers = Array[ExtResource("tr_mod")]([SubResource("tr_mod_zecche")])

