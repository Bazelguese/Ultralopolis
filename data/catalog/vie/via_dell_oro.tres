[resource]
script = ExtResource("12_qm22b")
id = &"via_dell_oro"
display_name = "Via dell'Oro"
description = "Rinnovare le opportunità costa 1 Oro in meno; Esattori più frequenti. Bonus: +10 Oro."
dimension = 5
extra_gold = 10
favored_opportunities = Array[ExtResource("3_plebw")]([ExtResource("8_bqfo6")])
exclusive_buildings = Array[ExtResource("1_nsx7d")]([ExtResource("2_mbxum")])
favored_by = Array[Resource]([ExtResource("5_4oon7"), ExtResource("6_vyvbh"), ExtResource("7_s6tqb")])
permanent_modifiers = Array[ExtResource("10_ikxyj")]([ExtResource("11_fgmxq")])
traditions = Array[ExtResource("tr_trad")]([SubResource("tr_step_zecche"), SubResource("tr_step_banchieri"), SubResource("tr_step_credito"), SubResource("tr_step_monopolio")])
