[resource]
script = ExtResource("14_r05ox")
id = &"via_dell_ombra"
display_name = "Via dell'Ombra"
description = "Inefficienza e Sabotaggio inflitti durano 1 s in più; Studiosi e Ambasciata più frequenti. Bonus: +5 Influenza."
dimension = 5
extra_resources = SubResource("Resource_78wfa")
favored_opportunities = Array[ExtResource("2_gvfs3")]([ExtResource("9_ig2le"), ExtResource("10_doiij")])
exclusive_troops = Array[ExtResource("3_dphoi")]([ExtResource("4_pm6jo")])
favored_by = Array[Resource]([ExtResource("6_wst1v"), ExtResource("7_nuugu"), ExtResource("8_paywp")])
permanent_modifiers = Array[ExtResource("11_ifuga")]([ExtResource("12_j6pe2"), ExtResource("13_xnhog")])
traditions = Array[ExtResource("tr_trad")]([SubResource("tr_step_informatori"), SubResource("tr_step_covi"), SubResource("tr_step_sicari"), SubResource("tr_step_ombra_lunga")])
