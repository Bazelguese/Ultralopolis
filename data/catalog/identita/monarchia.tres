[resource]
script = ExtResource("7_swsbc")
id = &"monarchia"
display_name = "Monarchia"
description = "Un sovrano e i suoi feudatari. Il primo consigliere che ascolti diventa il consigliere di corte e compare più spesso; Fortificazioni più frequenti e Tributi feudali esclusivi. Carta esclusiva: Castello del re (era 2). Capitale: +1 Stabilità."
dimension = 1
identity_type = &"Monarchico"
resistance_bonus = 6
exclusive_opportunities = Array[ExtResource("2_urday")]([ExtResource("3_yjl7w")])
favored_opportunities = Array[ExtResource("2_urday")]([ExtResource("5_7k12g")])
permanent_modifiers = Array[ExtResource("6_w7vpt")]([ExtResource("7_urday")])
court_advisor_weight = 2
evolves_to = Array[Resource]([ExtResource("p1"), ExtResource("p2")])
exclusive_buildings = Array[ExtResource("1_uilto")]([ExtResource("p3")])
