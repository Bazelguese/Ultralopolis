[resource]
script = ExtResource("x1")
id = &"spiriti_dei_luoghi"
display_name = "Spiriti dei luoghi"
description = "Ogni bosco e fiume ha uno spirito che aiuta gli edifici: mana prodotto il 10% più in fretta. Carta esclusiva: Bosco sacro (era 2); incanto esclusivo: Linfa degli spiriti. Capitale: +1 Legno."
dimension = 2
identity_type = &"Animista"
resistance_bonus = 2
permanent_modifiers = Array[ExtResource("x2")]([ExtResource("x3"), ExtResource("x4")])
exclusive_opportunities = Array[ExtResource("p1")]([ExtResource("p2")])
exclusive_buildings = Array[ExtResource("p4")]([ExtResource("p3")])
inclinations = PackedInt32Array(-1, 0, 1, 0)
