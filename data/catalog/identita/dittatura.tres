[ext_resource type="Resource" path="res://data/catalog/troops/esclusive/milizia_del_regime.tres" id="p2"]

[resource]
script = ExtResource("x1")
id = &"dittatura"
display_name = "Dittatura"
description = "Un solo uomo al comando. Compaiono 2 consiglieri, ma quello scelto offre una proposta in più. Carta esclusiva: Milizia del regime (era 2). Capitale: +1 Ferro."
dimension = 1
identity_type = &"Dittatoriale"
resistance_bonus = 6
tier = 2
evolves_to = Array[Resource]([ExtResource("x2")])
reform_requires_types = Array[StringName]([&"Patriota"])
advisors_change = -1
permanent_modifiers = Array[ExtResource("x3")]([ExtResource("x4"), ExtResource("x5")])
revolution_causes = Array[int]([0])
exclusive_troops = Array[ExtResource("p1")]([ExtResource("p2")])
