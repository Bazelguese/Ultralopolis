[resource]
script = ExtResource("x1")
id = &"maremani"
display_name = "Maremani"
description = "Anfibi delle lagune, barcaioli e commercianti. +3 Oro iniziale, Esattori più frequenti, può costruire il Porto lagunare. Poi i Cantori delle maree (era 2) e la Darsena delle lagune (era 3). Capitale: +1 Influenza."
identity_type = &"Maremano"
resistance_bonus = 2
extra_gold = 3
favored_opportunities = Array[ExtResource("x2")]([ExtResource("x4")])
exclusive_buildings = Array[ExtResource("x5")]([ExtResource("x6"), ExtResource("p1")])
permanent_modifiers = Array[ExtResource("x7")]([ExtResource("x8")])
exclusive_troops = Array[ExtResource("p3")]([ExtResource("p2")])
inclinations = PackedInt32Array(0, 1, 0, 0)
