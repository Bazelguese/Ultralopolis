[gd_resource type="Resource" script_class="IdentityDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/identity_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/troop_def.gd" id="x2"]
[ext_resource type="Resource" path="res://data/catalog/troops/esclusive/arcieri_delle_ceneri.tres" id="x3"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="x4"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/passo_leggero.tres" id="x5"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/capitale/capitale_cinerali_ferro.tres" id="x6"]

[resource]
script = ExtResource("x1")
id = &"cinerali"
display_name = "Cinerali"
description = "Popolo alato delle scogliere vulcaniche, rapido a colpire. Le truppe ricaricano del 10% più in fretta; può reclutare gli Arcieri delle ceneri. Capitale: +1 Ferro."
identity_type = &"Cinerale"
resistance_bonus = 4
exclusive_troops = Array[ExtResource("x2")]([ExtResource("x3")])
permanent_modifiers = Array[ExtResource("x4")]([ExtResource("x5"), ExtResource("x6")])
