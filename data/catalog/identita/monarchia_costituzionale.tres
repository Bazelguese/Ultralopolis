[resource]
script = ExtResource("x1")
id = &"monarchia_costituzionale"
display_name = "Monarchia costituzionale"
description = "Il sovrano giura sulla carta. Cancelliere più frequente; l'Ambasciata costa 1 Stabilità in meno (almeno 1). Carta esclusiva: Camera dei pari (era 2). Capitale: +1 Influenza."
dimension = 1
identity_type = &"Costituzionale"
resistance_bonus = 5
tier = 2
evolves_to = Array[Resource]([ExtResource("x2")])
reform_requires_types = Array[StringName]([&"Legge"])
action_discount = 1
favored_advisors = Array[ExtResource("x3")]([ExtResource("x4")])
cheaper_actions = Array[ExtResource("x5")]([ExtResource("x6")])
permanent_modifiers = Array[ExtResource("x7")]([ExtResource("x8")])
revolution_causes = Array[int]([1])
exclusive_buildings = Array[ExtResource("p1")]([ExtResource("p2")])
inclinations = PackedInt32Array(-1, 0, 0, 1)
