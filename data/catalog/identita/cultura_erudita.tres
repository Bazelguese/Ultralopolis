[resource]
script = ExtResource("x1")
id = &"cultura_erudita"
display_name = "Cultura erudita"
description = "Scuole e archivi, eredi dell'antico Ordine della Ragione: +3 Ricerca iniziale, +25% Ricerca prodotta, le azioni dello Studioso costano 1 unità in meno (almeno 1), Studiosi più frequenti. Carta esclusiva: Collegio dei saggi (era 2). Capitale: +1 Ricerca."
dimension = 3
identity_type = &"Erudito"
extra_research = 3
favored_opportunities = Array[ExtResource("x2")]([ExtResource("x3")])
permanent_modifiers = Array[ExtResource("x4")]([ExtResource("x5"), ExtResource("x6")])
cheaper_advisors = Array[ExtResource("p1")]([ExtResource("p2")])
action_discount = 1
exclusive_buildings = Array[ExtResource("p4")]([ExtResource("p3")])
inclinations = PackedInt32Array(0, 0, -1, 0)
