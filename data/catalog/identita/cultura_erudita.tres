[gd_resource type="Resource" script_class="IdentityDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/identity_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/opportunity_def.gd" id="x2"]
[ext_resource type="Resource" path="res://data/catalog/opportunities/studiosi.tres" id="x3"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="x4"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/metodo.tres" id="x5"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/capitale/capitale_cultura_erudita_ricerca.tres" id="x6"]

[resource]
script = ExtResource("x1")
id = &"cultura_erudita"
display_name = "Cultura erudita"
description = "Scuole e archivi, eredi dell'antico Ordine della Ragione: +3 Ricerca iniziale, +25% Ricerca prodotta, Studiosi più frequenti. Capitale: +1 Ricerca."
dimension = 3
extra_research = 3
favored_opportunities = Array[ExtResource("x2")]([ExtResource("x3")])
permanent_modifiers = Array[ExtResource("x4")]([ExtResource("x5"), ExtResource("x6")])
