[gd_resource type="Resource" script_class="IdentityDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/identity_def.gd" id="x1"]
[ext_resource type="Resource" path="res://data/catalog/identita/totalitarismo.tres" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="x3"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/capitale/capitale_monarchia_assoluta_stabilita.tres" id="x4"]

[resource]
script = ExtResource("x1")
id = &"monarchia_assoluta"
display_name = "Monarchia assoluta"
description = "Il sovrano non risponde a nessuno. Il consigliere di corte compare sempre fra quelli del round. Capitale: +1 Stabilità."
dimension = 1
identity_type = &"Assolutista"
resistance_bonus = 7
tier = 2
evolves_to = Array[Resource]([ExtResource("x2")])
reform_requires_types = Array[StringName]([&"Nobile"])
court_advisor_always = true
permanent_modifiers = Array[ExtResource("x3")]([ExtResource("x4")])
