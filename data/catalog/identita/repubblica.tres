[resource]
script = ExtResource("7_jtfog")
id = &"repubblica"
display_name = "Repubblica"
description = "Il potere a un consiglio eletto. In ogni round compaiono 4 consiglieri, ma le proposte costano 1 Oro in più; rinnovare le offerte costa 1 Oro in meno. Capitale: +1 Influenza."
dimension = 1
identity_type = &"Repubblicano"
resistance_bonus = 2
favored_opportunities = Array[ExtResource("2_5y0vq")]([ExtResource("4_4sdoy")])
permanent_modifiers = Array[ExtResource("5_uvpq4")]([ExtResource("6_4t4p0"), ExtResource("7_5y0vq")])
advisors_change = 1
proposal_gold_change = 1
evolves_to = Array[Resource]([ExtResource("p1"), ExtResource("p2")])
