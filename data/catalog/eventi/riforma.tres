[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x2"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
label = "Rimanda"
description = "Il governo resta com'è: la Riforma potrà tornare."

[resource]
script = ExtResource("x1")
id = &"riforma"
display_name = "La Riforma"
description = "A corte e in piazza si discute di cambiare il modo di governare. Ogni nuovo governo costa Influenza: di più per i governi di rango più alto."
special = 1
sphere = "Stato"
color = &"blu"
repeatable = true
options = Array[ExtResource("x2")]([SubResource("S1")])
favored_seasons = PackedInt32Array(0)
