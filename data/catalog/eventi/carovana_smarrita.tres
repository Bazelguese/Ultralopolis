[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
influenza = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Guidala in città"
description = "Ricevi 2 Influenza."
gain = SubResource("S1")

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
oro = 5

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
label = "Saccheggiala"
description = "Ricevi 5 Oro, ma il Malcontento sale di 2."
gain = SubResource("S3")
malcontent_change = 2

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
oro = 3
influenza = 1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Scortala"
description = "Ricevi 3 Oro e 1 Influenza."
gain = SubResource("S5")
requires_types = Array[StringName]([&"Fante"])
requires_kind = 2

[resource]
script = ExtResource("x1")
id = &"carovana_smarrita"
display_name = "La carovana smarrita"
description = "Una carovana di mercanti stranieri ha perso la strada vicino ai tuoi confini."
sphere = "Ricchezza"
color = &"verde"
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S4"), SubResource("S6")])
