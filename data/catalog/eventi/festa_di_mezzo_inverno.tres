[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
legno = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Accendi i falò"
description = "Paghi 2 Legno: il Malcontento scende di 2."
cost = SubResource("S1")
malcontent_change = -2

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
oro = 3

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
stabilita = 2

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Banchetto al palazzo"
description = "Paghi 3 Oro: ricevi 2 Stabilità e il Malcontento scende di 1."
cost = SubResource("S3")
gain = SubResource("S4")
malcontent_change = -1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x2")
stabilita = 1

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Lascia fare al popolo"
description = "Ricevi 1 Stabilità."
gain = SubResource("S6")

[sub_resource type="Resource" id="S8"]
script = ExtResource("x2")
stabilita = 2
influenza = 1

[sub_resource type="Resource" id="S9"]
script = ExtResource("x3")
label = "Canti dei padri"
description = "Ricevi 2 Stabilità e 1 Influenza."
gain = SubResource("S8")
requires_types = Array[StringName]([&"Patriota"])

[resource]
script = ExtResource("x1")
id = &"festa_di_mezzo_inverno"
display_name = "La festa di mezzo inverno"
description = "Nelle notti più lunghe dell'anno il popolo accende i falò e chiede una festa."
sphere = "Stato"
color = &"blu"
seasons = PackedInt32Array(0)
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S5"), SubResource("S7"), SubResource("S9")])
