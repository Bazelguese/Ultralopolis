[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="x4"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/presagio_di_guerra.tres" id="x5"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
fede = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Accoglilo"
description = "Ricevi 2 Fede."
gain = SubResource("S1")

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Chiedigli una profezia"
description = "In ogni scontro fino a quello con il fantasma (compreso) le truppe hanno la ricarica più corta del 10%, ma il popolo si spaventa: Malcontento +1."
malcontent_change = 1
modifiers = Array[ExtResource("x4")]([ExtResource("x5")])

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
fede = 2
stabilita = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Benedizione"
description = "Ricevi 2 Fede e 1 Stabilità."
gain = SubResource("S4")
requires_types = Array[StringName]([&"Spirituale"])

[resource]
script = ExtResource("x1")
id = &"pellegrino_cieco"
display_name = "Il pellegrino cieco"
description = "Un vecchio pellegrino bussa alle porte: dice di vedere ciò che verrà."
sphere = "Fede"
color = &"blu"
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S5")])
