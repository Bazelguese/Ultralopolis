[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
documenti = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Interrogalo"
description = "Ricevi 2 Documenti."
gain = SubResource("S1")

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Arruolalo"
description = "Ricevi una truppa dell'era, a caso (se c'è spazio), ma i tuoi soldati non si fidano: Malcontento +1."
malcontent_change = 1
give_random = true
give_random_kind = 2

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
stabilita = 2
documenti = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Processo militare"
description = "Ricevi 2 Stabilità e 1 Documenti."
gain = SubResource("S4")
requires_types = Array[StringName]([&"Legge"])

[resource]
script = ExtResource("x1")
id = &"disertore"
display_name = "Il disertore"
description = "Un soldato nemico si consegna alle tue guardie e chiede asilo."
sphere = "Militare"
color = &"rosso"
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S3"), SubResource("S5")])
