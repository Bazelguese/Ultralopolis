[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="e3"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="e4"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/giuramento_dei_nobili.tres" id="e5"]
[ext_resource type="Resource" path="res://data/catalog/identita/monarchia.tres" id="e6"]

[sub_resource type="Resource" id="RA_2"]
script = ExtResource("e3")
oro = 3

[sub_resource type="Resource" id="RA_3"]
script = ExtResource("e3")
stabilita = 3

[sub_resource type="Resource" id="OPT_1"]
script = ExtResource("e2")
label = "Festa di corte"
description = "Paghi 3 Oro, ricevi 3 Stabilità."
cost = SubResource("RA_2")
gain = SubResource("RA_3")

[sub_resource type="Resource" id="RA_5"]
script = ExtResource("e3")
stabilita = 2

[sub_resource type="Resource" id="RA_6"]
script = ExtResource("e3")
influenza = 4

[sub_resource type="Resource" id="OPT_4"]
script = ExtResource("e2")
label = "Matrimonio politico"
description = "Paghi 2 Stabilità, ricevi 4 Influenza."
cost = SubResource("RA_5")
gain = SubResource("RA_6")

[sub_resource type="Resource" id="OPT_7"]
script = ExtResource("e2")
label = "Il giuramento dei nobili"
description = "Per un anno le truppe Nobili ricaricano il 10% più in fretta."
requires_types = Array[StringName]([&"Nobile"])
modifiers = Array[ExtResource("e4")]([ExtResource("e5")])

[sub_resource type="Resource" id="N100_gain"]
script = ExtResource("e3")
stabilita = 1

[sub_resource type="Resource" id="N100"]
script = ExtResource("e2")
label = "Annuncio in piazza"
description = "Ricevi 1 Stabilità."
gain = SubResource("N100_gain")

[resource]
script = ExtResource("e1")
id = &"erede_al_trono"
display_name = "L'erede al trono"
description = "È nato l'erede al trono: la corte aspetta un segnale."
sphere = "Stato"
color = &"blu"
favored_by = Array[Resource]([ExtResource("e6")])
options = Array[ExtResource("e2")]([SubResource("OPT_1"), SubResource("OPT_4"), SubResource("OPT_7"), SubResource("N100")])
