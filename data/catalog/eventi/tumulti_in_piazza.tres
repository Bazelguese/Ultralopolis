[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
ferro = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
label = "Reprimi i tumulti"
description = "Paghi 2 Ferro: il Malcontento scende di 3."
cost = SubResource("S1")
malcontent_change = -3

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
oro = 3

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
label = "Concedi pane e feste"
description = "Paghi 3 Oro: il Malcontento scende di 2."
cost = SubResource("S3")
malcontent_change = -2

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
documenti = 1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Processi esemplari"
description = "Il Malcontento scende di 4 e ricevi 1 Documenti."
requires_types = Array[StringName]([&"Legge"])
gain = SubResource("S5")
malcontent_change = -4

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Lascia correre"
description = "Non fai nulla: il Malcontento sale di 1."
malcontent_change = 1

[resource]
script = ExtResource("x1")
id = &"tumulti_in_piazza"
display_name = "Tumulti in piazza"
description = "La folla riempie le piazze e chiede di essere ascoltata."
sphere = "Stato"
color = &"blu"
min_malcontent = 4
repeatable = true
options = Array[ExtResource("x3")]([SubResource("S2"), SubResource("S4"), SubResource("S6"), SubResource("S7")])
