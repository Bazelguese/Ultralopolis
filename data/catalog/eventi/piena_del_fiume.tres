[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="e3"]
[ext_resource type="Script" path="res://scripts/sim/data/modifier_def.gd" id="e4"]
[ext_resource type="Resource" path="res://data/catalog/modifiers/campi_allagati.tres" id="e5"]
[ext_resource type="Resource" path="res://data/catalog/identita/maremani.tres" id="e6"]

[sub_resource type="Resource" id="RA_2"]
script = ExtResource("e3")
legno = 3

[sub_resource type="Resource" id="RA_3"]
script = ExtResource("e3")
stabilita = 2

[sub_resource type="Resource" id="OPT_1"]
script = ExtResource("e2")
label = "Alza gli argini"
description = "Paghi 3 Legno, ricevi 2 Stabilità."
cost = SubResource("RA_2")
gain = SubResource("RA_3")

[sub_resource type="Resource" id="OPT_4"]
script = ExtResource("e2")
label = "Lascia allagare i campi"
description = "Fino alla fine dell'anno gli edifici di Materie prime producono 1 Cibo in più a ogni stagione, tranne d'inverno."
modifiers = Array[ExtResource("e4")]([ExtResource("e5")])

[sub_resource type="Resource" id="RA_6"]
script = ExtResource("e3")
oro = 4

[sub_resource type="Resource" id="OPT_5"]
script = ExtResource("e2")
label = "I mercanti noleggiano chiatte"
description = "Ricevi 4 Oro."
requires_types = Array[StringName]([&"Economico"])
gain = SubResource("RA_6")

[sub_resource type="Resource" id="N100_gain"]
script = ExtResource("e3")
cibo = 3
influenza = 2

[sub_resource type="Resource" id="N100"]
script = ExtResource("e2")
label = "I barcaioli salvano il raccolto"
description = "Ricevi 3 Cibo e 2 Influenza."
gain = SubResource("N100_gain")
requires_types = Array[StringName]([&"Maremano"])

[resource]
script = ExtResource("e1")
id = &"piena_del_fiume"
display_name = "La piena del fiume"
description = "Il fiume esce dagli argini e minaccia i campi."
sphere = "Terra"
color = &"verde"
favored_by = Array[Resource]([ExtResource("e6")])
options = Array[ExtResource("e2")]([SubResource("OPT_1"), SubResource("OPT_4"), SubResource("OPT_5"), SubResource("N100")])
seasons = PackedInt32Array(1)
