[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="e3"]
[ext_resource type="Resource" path="res://data/catalog/identita/ordine_della_ragione.tres" id="e4"]

[sub_resource type="Resource" id="RA_2"]
script = ExtResource("e3")
oro = 3

[sub_resource type="Resource" id="RA_3"]
script = ExtResource("e3")
ricerca = 3

[sub_resource type="Resource" id="OPT_1"]
script = ExtResource("e2")
label = "Finanzia la scuola"
description = "Paghi 3 Oro, ricevi 3 Ricerca."
cost = SubResource("RA_2")
gain = SubResource("RA_3")

[sub_resource type="Resource" id="RA_5"]
script = ExtResource("e3")
documenti = 2

[sub_resource type="Resource" id="RA_6"]
script = ExtResource("e3")
influenza = 3

[sub_resource type="Resource" id="OPT_4"]
script = ExtResource("e2")
label = "Pubblica gli atti"
description = "Paghi 2 Documenti, ricevi 3 Influenza."
cost = SubResource("RA_5")
gain = SubResource("RA_6")

[sub_resource type="Resource" id="RA_8"]
script = ExtResource("e3")
ricerca = 2
documenti = 2

[sub_resource type="Resource" id="OPT_7"]
script = ExtResource("e2")
label = "Il trattato fondamentale"
description = "Ricevi 2 Ricerca e 2 Documenti."
requires_types = Array[StringName]([&"Accademico"])
gain = SubResource("RA_8")

[resource]
script = ExtResource("e1")
id = &"disputa_dei_dotti"
display_name = "La disputa dei dotti"
description = "Due scuole di pensiero si contendono la capitale."
sphere = "Conoscenza"
color = &"viola"
favored_by = Array[Resource]([ExtResource("e4")])
options = Array[ExtResource("e2")]([SubResource("OPT_1"), SubResource("OPT_4"), SubResource("OPT_7")])
