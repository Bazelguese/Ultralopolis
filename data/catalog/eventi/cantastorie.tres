[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
label = "Ascoltalo"
description = "Il popolo si sente ascoltato: Malcontento −1."
malcontent_change = -1

[sub_resource type="Resource" id="S2"]
script = ExtResource("x3")
stabilita = 2

[sub_resource type="Resource" id="S3"]
script = ExtResource("x2")
label = "Fallo tacere"
description = "Ricevi 2 Stabilità, ma il Malcontento sale di 1."
gain = SubResource("S2")
malcontent_change = 1

[sub_resource type="Resource" id="S4"]
script = ExtResource("x3")
influenza = 2

[sub_resource type="Resource" id="S5"]
script = ExtResource("x2")
label = "Canti di gloria"
description = "Ricevi 2 Influenza e il Malcontento scende di 1."
gain = SubResource("S4")
requires_types = Array[StringName]([&"Patriota"])
malcontent_change = -1

[resource]
script = ExtResource("x1")
id = &"cantastorie"
display_name = "Il cantastorie"
description = "In piazza un cantastorie canta le imprese, e gli scandali, del tuo governo."
sphere = "Stato"
color = &"blu"
options = Array[ExtResource("x2")]([SubResource("S1"), SubResource("S3"), SubResource("S5")])
