[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]
[ext_resource type="Resource" path="res://data/catalog/identita/cinerali.tres" id="x4"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
cibo = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x2")
stabilita = 3

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Evacua i villaggi"
description = "Paghi 2 Cibo e ricevi 3 Stabilità."
cost = SubResource("S1")
gain = SubResource("S2")

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
ferro = 3
pietra = 1

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Raccogli l'ossidiana"
description = "Ricevi 3 Ferro e 1 Pietra."
gain = SubResource("S4")

[sub_resource type="Resource" id="S6"]
script = ExtResource("x3")
label = "Forgia nella lava"
description = "Un tuo edificio di Materie prime sale di un livello."
requires_types = Array[StringName]([&"Materie prime"])
requires_kind = 1
requirement_label = "edificio di Materie prime"
upgrade = true
upgrade_types = Array[StringName]([&"Materie prime"])
upgrade_kind = 1

[sub_resource type="Resource" id="N100_gain"]
script = ExtResource("x2")
ferro = 3
documenti = 2

[sub_resource type="Resource" id="N100"]
script = ExtResource("x3")
label = "Volano sopra la cenere"
description = "Ricevi 3 Ferro e 2 Documenti: le mappe dall'alto."
gain = SubResource("N100_gain")
requires_types = Array[StringName]([&"Cinerale"])

[resource]
script = ExtResource("x1")
id = &"montagna_si_sveglia"
display_name = "La montagna si sveglia"
description = "Il vulcano delle scogliere ha ripreso a fumare: cenere e lava scendono verso le valli."
sphere = "Terra"
color = &"rosso"
favored_by = Array[Resource]([ExtResource("x4")])
options = Array[ExtResource("x3")]([SubResource("S3"), SubResource("S5"), SubResource("S6"), SubResource("N100")])
