[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="x1"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="x2"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="x3"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("x2")
legno = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("x2")
stabilita = 2

[sub_resource type="Resource" id="S3"]
script = ExtResource("x3")
label = "Rinforza le case"
description = "Paghi 2 Legno: ricevi 2 Stabilità."
cost = SubResource("S1")
gain = SubResource("S2")

[sub_resource type="Resource" id="S4"]
script = ExtResource("x2")
pietra = 2

[sub_resource type="Resource" id="S5"]
script = ExtResource("x3")
label = "Taglia il ghiaccio"
description = "Ricevi 2 Pietra, ma il Malcontento sale di 1."
gain = SubResource("S4")
malcontent_change = 1

[sub_resource type="Resource" id="S6"]
script = ExtResource("x2")
legno = 1

[sub_resource type="Resource" id="S7"]
script = ExtResource("x3")
label = "Aspetta il disgelo"
description = "Ricevi 1 Legno."
gain = SubResource("S6")

[sub_resource type="Resource" id="S8"]
script = ExtResource("x2")
cibo = 2

[sub_resource type="Resource" id="S9"]
script = ExtResource("x3")
label = "Le scorte del granaio"
description = "Ricevi 2 Cibo."
gain = SubResource("S8")
requires_types = Array[StringName]([&"Materie prime"])

[resource]
script = ExtResource("x1")
id = &"il_gelo"
display_name = "Il gelo"
description = "Una gelata improvvisa ghiaccia i fiumi e spacca le pietre."
sphere = "Terra"
color = &"verde"
seasons = PackedInt32Array(0)
options = Array[ExtResource("x3")]([SubResource("S3"), SubResource("S5"), SubResource("S7"), SubResource("S9")])
