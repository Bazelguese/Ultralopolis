[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="e3"]
[ext_resource type="Resource" path="res://data/catalog/identita/cultura_erudita.tres" id="e4"]

[sub_resource type="Resource" id="RA_2"]
script = ExtResource("e3")
documenti = 2
ricerca = 1

[sub_resource type="Resource" id="OPT_1"]
script = ExtResource("e2")
label = "Prendi il dono"
description = "Ricevi 2 Documenti, 1 Ricerca, moltiplicati per l'era, e una tecnologia di Conoscenza già iniziata a metà."
gain = SubResource("RA_2")
give_random_tech = true
give_tech_sphere = "Conoscenza"

[resource]
script = ExtResource("e1")
id = &"biblioteca_ritrovata"
display_name = "La biblioteca ritrovata"
description = "Sotto le rovine c'è una biblioteca intatta."
family = 1
sphere = "Conoscenza"
color = &"viola"
favored_by = Array[Resource]([ExtResource("e4")])
options = Array[ExtResource("e2")]([SubResource("OPT_1")])
scale_with_era = true
