[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/sim/data/event_def.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/sim/data/event_option_def.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/sim/data/resource_amounts.gd" id="e3"]
[ext_resource type="Resource" path="res://data/catalog/troops/esploratori.tres" id="e4"]
[ext_resource type="Resource" path="res://data/catalog/identita/antichi_spiriti.tres" id="e5"]

[sub_resource type="Resource" id="RA_2"]
script = ExtResource("e3")
cibo = 2

[sub_resource type="Resource" id="RA_3"]
script = ExtResource("e3")
fede = 3

[sub_resource type="Resource" id="OPT_1"]
script = ExtResource("e2")
label = "Offerta agli spiriti"
description = "Paghi 2 Cibo, ricevi 3 Fede."
cost = SubResource("RA_2")
gain = SubResource("RA_3")

[sub_resource type="Resource" id="RA_5"]
script = ExtResource("e3")
legno = 4

[sub_resource type="Resource" id="OPT_4"]
script = ExtResource("e2")
label = "Abbatti il bosco"
description = "Ricevi 4 Legno."
gain = SubResource("RA_5")

[sub_resource type="Resource" id="OPT_6"]
script = ExtResource("e2")
label = "I guardiani del bosco"
description = "Ricevi gli Esploratori, se c'è spazio."
requires_types = Array[StringName]([&"Guardiano"])
give_troop = ExtResource("e4")

[resource]
script = ExtResource("e1")
id = &"bosco_che_sussurra"
display_name = "Il bosco che sussurra"
description = "Di notte il vecchio bosco parla con voci antiche."
sphere = "Fede"
color = &"blu"
favored_by = Array[Resource]([ExtResource("e5")])
options = Array[ExtResource("e2")]([SubResource("OPT_1"), SubResource("OPT_4"), SubResource("OPT_6")])
