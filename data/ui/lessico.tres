colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"rinnovo"
definizione = "Paghi per vedere tre opportunità nuove dallo stesso consigliere. Costa Oro o la risorsa del consigliere, ogni volta un po' di più."

[sub_resource type="Resource" id="voce_n03"]
