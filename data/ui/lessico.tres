[sub_resource type="Resource" id="voce_10"]
script = ExtResource("1_voce")
nome = "Danno"
forme = PackedStringArray("danno", "danni")
colore = Color(0.8824, 0.502, 0.4941, 1)
simbolo = &"danno"
definizione = "Colpisce prima lo scudo; solo ciò che avanza arriva alla Resistenza."

[sub_resource type="Resource" id="voce_11"]
script = ExtResource("1_voce")
nome = "Resistenza"
forme = PackedStringArray("resistenza")
colore = Color(0.5608, 0.8902, 0.6902, 1)
simbolo = &"resistenza"
definizione = "Capacità della nazione di sopravvivere al singolo scontro. Chi arriva a zero perde."

[sub_resource type="Resource" id="voce_12"]
script = ExtResource("1_voce")
nome = "Scudo"
forme = PackedStringArray("scudo", "scudi")
colore = Color(0.3882, 0.5765, 0.8627, 1)
simbolo = &"scudo"
definizione = "Riserva di battaglia che assorbe il danno prima della Resistenza. Parte da zero in ogni scontro, non ha tetto e non ferma la Corruzione."

[sub_resource type="Resource" id="voce_13"]
script = ExtResource("1_voce")
nome = "Cura"
forme = PackedStringArray("cura", "cure")
colore = Color(0.3882, 0.7137, 0.5059, 1)
simbolo = &"cura"
definizione = "Ridà Resistenza persa, mai oltre la Resistenza massima. Così allontana anche la soglia della Corruzione."

[sub_resource type="Resource" id="voce_14"]
script = ExtResource("1_voce")
nome = "Corruzione"
forme = PackedStringArray("corruzione")
colore = Color(0.7059, 0.5098, 0.8627, 1)
simbolo = &"corruzione"
definizione = "Contatore di battaglia che parte da zero e si accumula: quando raggiunge la Resistenza attuale, la nazione perde. Non tocca lo scudo e non scende mai; l'unica risposta è la cura."

[sub_resource type="Resource" id="voce_15"]
script = ExtResource("1_voce")
nome = "Attacco d'assedio"
forme = PackedStringArray("attacco d'assedio", "attacco d’assedio", "attacchi d'assedio", "assedio")
colore = Color(0.6078, 0.5608, 0.502, 1)
simbolo = &"assedio"
definizione = "Danno che colpisce solo lo scudo, prima del danno normale; proprio delle truppe Assedio. Se l'avversario non ha scudo, va perso."

[sub_resource type="Resource" id="voce_16"]
script = ExtResource("1_voce")
nome = "Inefficienza (rallenta)"
forme = PackedStringArray("inefficienza", "rallenta", "rallentano", "rallentato", "rallentata", "rallentati", "rallentate", "rallentamento")
colore = Color(0.3725, 0.8902, 0.8235, 1)
simbolo = &"inefficienza"
definizione = "Per una durata in secondi il timer del bersaglio (ricarica di una truppa, intervallo di un edificio) avanza più piano. Se colpisce di nuovo, le durate si sommano."

[sub_resource type="Resource" id="voce_17"]
script = ExtResource("1_voce")
nome = "Sabotaggio (blocca)"
forme = PackedStringArray("sabotaggio", "sabota", "sabotano", "sabotato", "sabotata", "sabotati", "sabotate")
colore = Color(1, 0.4784, 0.7216, 1)
simbolo = &"sabotaggio"
definizione = "Per una durata in secondi il timer del bersaglio è fermo e il bersaglio non può attivarsi, nemmeno se è pronto e il mana c'è. Se colpisce di nuovo, le durate si sommano."

[sub_resource type="Resource" id="voce_18"]
script = ExtResource("1_voce")
nome = "Ricarica"
forme = PackedStringArray("ricarica", "ricaricano", "ricaricare", "ricariche")
colore = Color(0.5608, 0.5882, 0.651, 1)
simbolo = &"ricarica"
definizione = "Tempo di attesa fra due attivazioni di una truppa. Truppe ed edifici iniziano la battaglia con ricarica e intervallo pieni."

[sub_resource type="Resource" id="voce_19"]
script = ExtResource("1_voce")
nome = "Logoramento"
forme = PackedStringArray("logoramento")
colore = Color(0.851, 0.549, 0.4157, 1)
definizione = "Contro gli stalli: dopo un po' di battaglia entrambe le nazioni perdono Resistenza con un danno che cresce nel tempo. Lo scudo lo assorbe e le cure lo compensano."

[sub_resource type="Resource" id="voce_20"]
script = ExtResource("1_voce")
nome = "Mana"
forme = PackedStringArray("mana")
colore = Color(0.7255, 0.7843, 1, 1)
definizione = "Prodotto in battaglia dagli edifici e speso per attivare le truppe. Parte da zero in ogni scontro e si azzera alla fine. Se manca, la truppa pronta resta in attesa."

