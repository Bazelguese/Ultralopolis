definizione = "Una delle tre cose che un consigliere ti offre: un'azione, un edificio o una truppa. Ne prendi una sola."
di_base = true
eccezioni = Dictionary[int, String]({7: "Con Doppio ascolto, la prima volta in ogni stagione puoi prenderne subito un'altra (non con Giullare e Anziano)."})

[sub_resource type="Resource" id="voce_n01"]
script = ExtResource("1_voce")
nome = "Potenzia"
famiglia = 6
forme = PackedStringArray("potenzia", "potenziare", "potenziata", "potenziate", "potenziato", "potenziati", "potenziamento", "potenziamenti")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"potenzia"
definizione = "Fa salire di livello una tua tessera che ha un tipo del consigliere. Non conta come scelta del round e si usa una volta per round."

[sub_resource type="Resource" id="voce_n02"]
script = ExtResource("1_voce")
