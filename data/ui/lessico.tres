[sub_resource type="Resource" id="voce_46"]
script = ExtResource("1_voce")
nome = "Malus"
famiglia = 5
forme = PackedStringArray("malus")
colore = Color(1, 0.3608, 0.4235, 1)
simbolo = &"malus"
definizione = "Effetto negativo con una durata in anni. Se arriva un malus già attivo si allunga solo la durata. Lo infliggono i fantasmi quando perdi o pareggi."

[sub_resource type="Resource" id="voce_47"]
script = ExtResource("1_voce")
nome = "Malcontento"
famiglia = 5
forme = PackedStringArray("malcontento")
colore = Color(1, 0.3608, 0.4235, 1)
simbolo = &"malcontento"
definizione = "Contatore della nazione: sale con sconfitte, carestie, malus subiti ed eventi; scende spendendo Stabilità (anche Fede o Cibo). Alla soglia scoppia la Rivoluzione."

[sub_resource type="Resource" id="voce_48"]
script = ExtResource("1_voce")
nome = "Rivoluzione"
famiglia = 5
forme = PackedStringArray("rivoluzione")
colore = Color(1, 0.3608, 0.4235, 1)
definizione = "Arriva da sola quando il Malcontento raggiunge la soglia: la nazione cambia governo, anche di tier più basso. Poi il Malcontento si azzera."

[sub_resource type="Resource" id="voce_49"]
script = ExtResource("1_voce")
nome = "Affamata"
famiglia = 5
forme = PackedStringArray("affamata", "affamate", "affamato", "affamati")
colore = Color(0.8784, 0.5412, 0.1804, 1)
definizione = "Truppa rimasta senza Cibo all'inizio dell'anno: ricarica più lenta (×1,5) fino al pasto dell'anno dopo."

[sub_resource type="Resource" id="voce_50"]
script = ExtResource("1_voce")
nome = "Carestia"
famiglia = 5
forme = PackedStringArray("carestia", "carestie")
colore = Color(1, 0.3608, 0.4235, 1)

[sub_resource type="Resource" id="voce_51"]
script = ExtResource("1_voce")
nome = "Sconfitta"
famiglia = 5
forme = PackedStringArray("sconfitta", "sconfitte")
colore = Color(1, 0.3608, 0.4235, 1)

[sub_resource type="Resource" id="voce_52"]
script = ExtResource("1_voce")
nome = "Proposta"
famiglia = 6
forme = PackedStringArray("proposta", "proposte", "propone", "propongono")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"proposta"
definizione = "Ciò che un consigliere offre nel round: ne mostra 3 e se ne prende una sola. Azioni, edifici e truppe della sua categoria, secondo il tema del round."

[sub_resource type="Resource" id="voce_53"]
script = ExtResource("1_voce")
nome = "Potenzia"
famiglia = 6
forme = PackedStringArray("potenzia", "potenziare", "potenziata", "potenziate", "potenziato", "potenziati", "potenziamento", "potenziamenti")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"potenzia"
definizione = "Opzione dei consiglieri: porta di livello una carta con almeno un tipo della loro categoria, pagando la risorsa della categoria. Non consuma la scelta del round e si usa una volta per round."

[sub_resource type="Resource" id="voce_54"]
script = ExtResource("1_voce")
nome = "Rinnovo"
famiglia = 6
forme = PackedStringArray("rinnova", "rinnovare", "rinnovano", "rinnovo", "rinnovi")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"rinnovo"
definizione = "Ripesca le proposte del consigliere scelto. Si paga in Oro o con la risorsa della sua categoria; il costo sale a ogni rinnovo."

[sub_resource type="Resource" id="voce_55"]
script = ExtResource("1_voce")
nome = "Ascolta"
famiglia = 6
forme = PackedStringArray("ascolta", "ascoltare")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Sceglie il consigliere del round: la scelta è definitiva per quel round. Poi si prende una delle sue proposte, oppure si passa."

[sub_resource type="Resource" id="voce_56"]
script = ExtResource("1_voce")
nome = "Consigliere"
famiglia = 6
forme = PackedStringArray("consigliere", "consiglieri", "Consiglio")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Membro del Consiglio: in ogni round ne compaiono 3 e se ne ascolta uno. Propone azioni, edifici e truppe della sua categoria e offre Potenzia."

[sub_resource type="Resource" id="voce_57"]
script = ExtResource("1_voce")
nome = "Visitatore"
famiglia = 6
forme = PackedStringArray("visitatore", "visitatori")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Consigliere di passaggio con proposte e prezzi propri."

[sub_resource type="Resource" id="voce_58"]
script = ExtResource("1_voce")
nome = "Evento"
famiglia = 6
forme = PackedStringArray("evento", "eventi")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Carta del round con un testo e 2-3 opzioni, alcune sbloccate dalla nazione. Almeno un'opzione è sempre gratuita e senza requisiti."

[sub_resource type="Resource" id="voce_59"]
script = ExtResource("1_voce")
nome = "Fortuna"
famiglia = 6
forme = PackedStringArray("Fortuna", "Fortune")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Carta del round con un dono semplice."

[sub_resource type="Resource" id="voce_60"]
script = ExtResource("1_voce")
nome = "Incanto"
famiglia = 6
forme = PackedStringArray("incanto", "incanti", "incanta", "incantare", "incantata", "incantato")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"incanto"
definizione = "Il Sacerdote aggiunge a una truppa un effetto in battaglia e un costo di mana in più. Una truppa si incanta una sola volta; l'incanto resta per tutta la run."

[sub_resource type="Resource" id="voce_61"]
script = ExtResource("1_voce")
nome = "Spionaggio"
famiglia = 6
forme = PackedStringArray("spionaggio")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"spia"
definizione = "Proposta del Maestro delle spie: lo scontro con il fantasma dell'anno parte con un suo elemento sabotato o rallentato per alcuni secondi."

[sub_resource type="Resource" id="voce_62"]
script = ExtResource("1_voce")
nome = "Mercato"
famiglia = 6
forme = PackedStringArray("mercato")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "In ogni round si possono vendere risorse in cambio di Oro, a tasso fisso, senza consumare il round. Solo in vendita; la Ricerca non si vende."

[sub_resource type="Resource" id="voce_63"]
script = ExtResource("1_voce")
nome = "Livello"
famiglia = 7
forme = PackedStringArray("livello", "livelli")
colore = Color(1, 0.8431, 0.4157, 1)
definizione = "Ogni edificio e ogni truppa ha 3 livelli; si sale con Potenzia. Ogni livello aumenta tutti i valori d'effetto e gli edifici producono più risorse."

[sub_resource type="Resource" id="voce_64"]
script = ExtResource("1_voce")
nome = "Era"
famiglia = 7
forme = PackedStringArray("Era", "ere", "era 1", "era 2", "era 3", "era 4", "era attuale", "era corrente", "era successiva", "nuova era", "prossima era")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Livello di sviluppo raggiunto completando un certo numero di tecnologie. Entrando in un'era nuova le offerte dell'era precedente spariscono."

[sub_resource type="Resource" id="voce_65"]
script = ExtResource("1_voce")
nome = "Tecnologia"
famiglia = 7
forme = PackedStringArray("tecnologia", "tecnologie")
colore = Color(0.7804, 0.7216, 1, 1)
simbolo = &"tecnologia"
definizione = "Carta dell'albero che si completa con la Ricerca e dà un effetto permanente."

[sub_resource type="Resource" id="voce_66"]
script = ExtResource("1_voce")
nome = "Via"
famiglia = 7
forme = PackedStringArray("Via", "Vie")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Direzione di sviluppo scelta fra 3 entrando in un'era, dalla seconda in poi. Diventa parte dell'identità ed è un albero di tradizioni."

[sub_resource type="Resource" id="voce_67"]
script = ExtResource("1_voce")
nome = "Tradizione"
famiglia = 7
forme = PackedStringArray("tradizione", "tradizioni")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Uno dei 4 passi dell'albero di una via; si completa con un'impresa."

[sub_resource type="Resource" id="voce_68"]
script = ExtResource("1_voce")
nome = "Impresa"
famiglia = 7
forme = PackedStringArray("impresa", "imprese")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Obiettivo che completa una tradizione: un traguardo o uno stato della nazione."

[sub_resource type="Resource" id="voce_69"]
script = ExtResource("1_voce")
nome = "Ascensione"
famiglia = 7
forme = PackedStringArray("ascensione", "ascensioni")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Effetto permanente scelto completando l'albero di una via; il livello 2 cambia una regola."

[sub_resource type="Resource" id="voce_70"]
script = ExtResource("1_voce")
nome = "Perk"
famiglia = 7
forme = PackedStringArray("perk")
colore = Color(0.7804, 0.7216, 1, 1)
simbolo = &"perk"
definizione = "Bonus passivo, come le abilità di The Bazaar: alcuni si scelgono alla creazione della nazione, altri arrivano durante la run."

[sub_resource type="Resource" id="voce_71"]
script = ExtResource("1_voce")
nome = "Governo"
famiglia = 7
forme = PackedStringArray("governo", "governi")
colore = Color(0.7804, 0.7216, 1, 1)
simbolo = &"governo"
definizione = "Forma di governo della nazione, a tier. Evolve entrando in una nuova era o con la Riforma; la Rivoluzione può portare a qualsiasi governo."

[sub_resource type="Resource" id="voce_72"]
script = ExtResource("1_voce")
nome = "Usanza"
famiglia = 7
forme = PackedStringArray("usanza", "usanze")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Tratto permanente preso quando un'inclinazione arriva a un estremo."

[sub_resource type="Resource" id="voce_73"]
script = ExtResource("1_voce")
nome = "Vocazione"
famiglia = 7
forme = PackedStringArray("vocazione", "vocazioni")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Modo di giocare aperto da due usanze, accettato in una cronaca."

[sub_resource type="Resource" id="voce_74"]
script = ExtResource("1_voce")
nome = "Inclinazione"
famiglia = 7
forme = PackedStringArray("inclinazione", "inclinazioni")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Una delle quattro tendenze della nazione fra due poli opposti (Spada, Porta, Altare, Legge)."

[sub_resource type="Resource" id="voce_75"]
script = ExtResource("1_voce")
nome = "Tipo"
famiglia = 7
forme = PackedStringArray("tipo", "tipi")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Caratteristica di un edificio o di una truppa che decide quali consiglieri lo propongono e lo potenziano e a quali perk risponde."

[sub_resource type="Resource" id="voce_76"]
script = ExtResource("1_voce")
nome = "Categoria"
famiglia = 7
forme = PackedStringArray("categoria", "categorie")
colore = Color(0.7804, 0.7216, 1, 1)
definizione = "Insieme di tipi che forma il campo di un consigliere."

[sub_resource type="Resource" id="voce_77"]
script = ExtResource("1_voce")
nome = "Capitale"
famiglia = 8
forme = PackedStringArray("Capitale")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Il primo edificio della nazione: in battaglia produce 1 mana energetico; a ogni fase Oro, Cibo e Ricerca, più una risorsa per ogni elemento dell'identità. Non si vende né si sostituisce."

[sub_resource type="Resource" id="voce_78"]
script = ExtResource("1_voce")
nome = "Spazio"
famiglia = 8
forme = PackedStringArray("spazio", "spazi")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Posto sulla plancia per un edificio o una truppa. Gli spazi arrivano entrando nelle ere, da edifici che li concedono e comprandoli con l'Oro."

[sub_resource type="Resource" id="voce_79"]
script = ExtResource("1_voce")
nome = "Mantenimento"
famiglia = 8
forme = PackedStringArray("mantenimento")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Prima di ogni scontro le carte potenziate e quelle speciali pagano la risorsa della categoria del loro primo tipo. Una carta non pagata è trascurata (ricarica ×1,5) e dà +1 Malcontento."

[sub_resource type="Resource" id="voce_80"]
script = ExtResource("1_voce")
nome = "Esclusiva"
famiglia = 8
forme = PackedStringArray("esclusiva", "esclusivo", "esclusive", "esclusivi")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Carta concessa da un elemento dell'identità o da una via: compare solo per quella nazione. È una carta speciale, quindi paga il mantenimento."

[sub_resource type="Resource" id="voce_81"]
script = ExtResource("1_voce")
nome = "Fantasma"
famiglia = 8
forme = PackedStringArray("fantasma", "fantasmi")
colore = Color(0.9412, 0.851, 0.6588, 1)
simbolo = &"fantasma"
definizione = "Copia di una nazione avversaria usata per uno scontro asincrono. Si affronta a fine anno; perdere costa Prestigio."

[sub_resource type="Resource" id="voce_82"]
script = ExtResource("1_voce")
nome = "Incontro del mondo"
famiglia = 8
forme = PackedStringArray("incontro del mondo", "incontri del mondo", "incontro", "incontri")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Minaccia dell'anno (es. barbari, pirati): due per anno, a fine primavera e a fine estate, scegliendone uno fra 3. Perdere dimezza l'Oro, senza perdere Prestigio."

[sub_resource type="Resource" id="voce_83"]
