[sub_resource type="Resource" id="voce_10"]
script = ExtResource("1_voce")
nome = "Danno"
forme = PackedStringArray("danno", "danni")
colore = Color(1, 0.4157, 0.2392, 1)
simbolo = &"danno"
definizione = "Toglie Resistenza al nemico, ma prima consuma il suo scudo; solo ciò che avanza arriva alla Resistenza."
di_base = true

[sub_resource type="Resource" id="voce_11"]
script = ExtResource("1_voce")
nome = "Resistenza"
forme = PackedStringArray("resistenza")
colore = Color(1, 0.702, 0.6392, 1)
simbolo = &"resistenza"
definizione = "La vita della tua nazione nello scontro. Se arriva a zero, perdi. Si ricalcola all'inizio di ogni scontro."
di_base = true
eccezioni = Dictionary[int, String]({2: "Con Ultima trincea, la prima volta in ogni scontro che arriva a zero torna a 1 (non salva dalla Corruzione)."})

[sub_resource type="Resource" id="voce_12"]
script = ExtResource("1_voce")
nome = "Scudo"
forme = PackedStringArray("scudo", "scudi")
colore = Color(0.4863, 0.7843, 1, 1)
simbolo = &"scudo"
definizione = "Una riserva che assorbe il danno prima della Resistenza. Di solito parte da zero in ogni scontro e resta finché non viene consumata; non ferma la Corruzione."
di_base = true

[sub_resource type="Resource" id="voce_13"]
script = ExtResource("1_voce")
nome = "Cura"
forme = PackedStringArray("cura", "cure")
colore = Color(0.3569, 0.8902, 0.4902, 1)
simbolo = &"cura"
definizione = "Ridà Resistenza persa, mai oltre il massimo. Così allontana anche la soglia della Corruzione."

[sub_resource type="Resource" id="voce_14"]
script = ExtResource("1_voce")
nome = "Corruzione"
forme = PackedStringArray("corruzione")
colore = Color(0.7608, 0.2157, 0.5412, 1)
simbolo = &"corruzione"
definizione = "Sale durante lo scontro e non scende mai. Quando raggiunge la tua Resistenza, perdi. Lo scudo non la ferma: l'unica risposta è la cura."

[sub_resource type="Resource" id="voce_15"]
script = ExtResource("1_voce")
nome = "Danno d'assedio"
forme = PackedStringArray("danno d'assedio", "danno d’assedio", "danni d'assedio", "danni d’assedio")
colore = Color(1, 0.6941, 0.2902, 1)
simbolo = &"assedio"
definizione = "Toglie solo scudo al nemico, prima del danno normale. Ce l'hanno solo le truppe Assedio; se il nemico non ha scudo, va perso."

[sub_resource type="Resource" id="voce_16"]
script = ExtResource("1_voce")
nome = "Inefficienza"
forme = PackedStringArray("inefficienza", "inefficiente", "inefficienti")
colore = Color(0.3725, 0.8902, 0.8235, 1)
simbolo = &"inefficienza"
definizione = "Per qualche secondo il timer della tessera colpita (ricarica di una truppa, ciclo di un edificio) va a metà velocità. Se colpisce di nuovo, le durate si sommano."

[sub_resource type="Resource" id="voce_17"]
script = ExtResource("1_voce")
nome = "Sabotaggio"
forme = PackedStringArray("sabotaggio", "sabota", "sabotano", "sabotato", "sabotata", "sabotati", "sabotate")
colore = Color(1, 0.4784, 0.7216, 1)
simbolo = &"sabotaggio"
definizione = "Per qualche secondo la tessera colpita è ferma e non può attivarsi, nemmeno se è pronta e il mana c'è. Se colpisce di nuovo, le durate si sommano."

[sub_resource type="Resource" id="voce_18"]
script = ExtResource("1_voce")
nome = "Ricarica"
forme = PackedStringArray("ricarica", "ricaricano", "ricaricare", "ricariche")
colore = Color(0.6627, 0.7608, 1, 1)
simbolo = &"ricarica"
definizione = "Il tempo che una truppa aspetta fra un'attivazione e la successiva. Per gli edifici si dice ciclo. Lo scontro inizia con ricariche e cicli pieni."
di_base = true
eccezioni = Dictionary[int, String]({3: "Con Prima scintilla i tuoi edifici iniziano lo scontro con il ciclo a metà."})

[sub_resource type="Resource" id="voce_19"]
script = ExtResource("1_voce")
nome = "Logoramento"
forme = PackedStringArray("logoramento")
colore = Color(0.851, 0.549, 0.4157, 1)
definizione = "Dopo 45 secondi entrambe le nazioni perdono Resistenza, sempre di più, finché lo scontro finisce. Lo scudo lo assorbe e le cure lo compensano."

[sub_resource type="Resource" id="voce_20"]
script = ExtResource("1_voce")
nome = "Mana"
forme = PackedStringArray("mana")
colore = Color(0.7255, 0.7843, 1, 1)
definizione = "L'energia che gli edifici producono nello scontro e che le truppe spendono per attivarsi. Parte da zero e si azzera a fine scontro; se manca, la truppa pronta resta in attesa."
di_base = true
eccezioni = Dictionary[int, String]({4: "Con Disciplina ferrea, se la tua truppa più a destra è pronta e aspetta il mana, le altre non lo spendono (quelle senza mana si attivano comunque).", 5: "Con Mana unito le tue truppe pagano anche con gli altri colori."})

