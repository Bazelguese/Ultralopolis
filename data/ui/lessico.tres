colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"incanto"
definizione = "Il Sacerdote aggiunge a una truppa un effetto in più nello scontro, con un costo di mana in più. Ogni truppa si incanta una volta sola."

[sub_resource type="Resource" id="voce_n10"]
script = ExtResource("1_voce")
nome = "Spionaggio"
famiglia = 6
forme = PackedStringArray("spionaggio")
colore = Color(0.5451, 0.9137, 0.9922, 1)
simbolo = &"spia"
definizione = "Le opportunità del Maestro delle spie: lo scontro con il fantasma dell'anno inizia con un suo edificio o una sua truppa già sabotati o inefficienti."

[sub_resource type="Resource" id="voce_n11"]
script = ExtResource("1_voce")
nome = "Mercato"
famiglia = 6
forme = PackedStringArray("mercato")
colore = Color(0.5451, 0.9137, 0.9922, 1)
definizione = "Vendi risorse in cambio di Oro, quando vuoi fuori dallo scontro. Non si possono comprare risorse."

[sub_resource type="Resource" id="voce_n12"]
script = ExtResource("1_voce")
nome = "Livello"
famiglia = 7
forme = PackedStringArray("livello", "livelli")
colore = Color(1, 0.8431, 0.4157, 1)
definizione = "Una tessera va dal livello 1 al 3; ogni livello rafforza tutti i suoi effetti."
di_base = true

[sub_resource type="Resource" id="voce_n13"]
script = ExtResource("1_voce")
nome = "Era"
famiglia = 7
forme = PackedStringArray("Era", "ere", "era 1", "era 2", "era 3", "era 4", "era attuale", "era corrente", "era successiva", "nuova era", "prossima era")
colore = Color(1, 1, 1, 1)
definizione = "Un'epoca della tua nazione. Ci entri quando vuoi, dopo aver completato abbastanza tecnologie dell'era in corso: porta tessere nuove, spazi in più e più Resistenza."

[sub_resource type="Resource" id="voce_n14"]
script = ExtResource("1_voce")
nome = "Tecnologia"
famiglia = 7
forme = PackedStringArray("tecnologia", "tecnologie")
colore = Color(1, 1, 1, 1)
simbolo = &"tecnologia"
definizione = "Una scoperta che studi con la Ricerca. Completata, vale per sempre: tessere nuove, peculiarità, aiuti del Consiglio, spazi o bonus sui tipi."

[sub_resource type="Resource" id="voce_n15"]
script = ExtResource("1_voce")
nome = "Via"
famiglia = 7
forme = PackedStringArray("Via", "Vie")
colore = Color(1, 1, 1, 1)
definizione = "Dalla seconda era, entrando in un'era scegli fra tre direzioni di sviluppo. La via diventa parte della tua identità."

[sub_resource type="Resource" id="voce_n16"]
script = ExtResource("1_voce")
nome = "Tradizione"
famiglia = 7
forme = PackedStringArray("tradizione", "tradizioni")
colore = Color(1, 1, 1, 1)
definizione = "Una delle 4 tappe dell'albero di una via. Si completa da sola appena riesci nella sua impresa, e dà un effetto permanente."

[sub_resource type="Resource" id="voce_n17"]
script = ExtResource("1_voce")
nome = "Impresa"
famiglia = 7
forme = PackedStringArray("impresa", "imprese")
colore = Color(1, 1, 1, 1)
definizione = "L'obiettivo che completa una tradizione: un traguardo (es. vincere 3 scontri) o uno stato della nazione (es. 4 tessere Fante sulla plancia)."

[sub_resource type="Resource" id="voce_n18"]
script = ExtResource("1_voce")
nome = "Ascensione"
famiglia = 7
forme = PackedStringArray("ascensione", "ascensioni")
colore = Color(1, 1, 1, 1)
definizione = "Completate le 4 tradizioni di una via, scegli un'ascensione fra 3: un effetto permanente forte. Quelle di livello 2 cambiano una regola del gioco."

[sub_resource type="Resource" id="voce_n19"]
script = ExtResource("1_voce")
nome = "Peculiarità"
famiglia = 7
forme = PackedStringArray("peculiarità")
colore = Color(1, 1, 1, 1)
simbolo = &"perk"
definizione = "Un bonus passivo. Alcune si scelgono creando la nazione, altre si ottengono durante la partita."

[sub_resource type="Resource" id="voce_n20"]
script = ExtResource("1_voce")
nome = "Governo"
famiglia = 7
forme = PackedStringArray("governo", "governi")
colore = Color(1, 1, 1, 1)
simbolo = &"governo"
definizione = "Come decidi: cambia il modo in cui funziona il Consiglio. Può evolvere o cambiare con una rivoluzione."

[sub_resource type="Resource" id="voce_n21"]
script = ExtResource("1_voce")
nome = "Usanza"
famiglia = 7
forme = PackedStringArray("usanza", "usanze")
colore = Color(1, 1, 1, 1)
definizione = "Quando un'inclinazione arriva a un estremo, la nazione prende un'usanza: un tratto permanente con un nome e una storia."

[sub_resource type="Resource" id="voce_n22"]
script = ExtResource("1_voce")
nome = "Vocazione"
famiglia = 7
forme = PackedStringArray("vocazione", "vocazioni")
colore = Color(1, 1, 1, 1)
definizione = "Un modo di giocare speciale, aperto da due usanze compatibili. Arriva come una cronaca: la accetti o la rifiuti."

[sub_resource type="Resource" id="voce_n23"]
script = ExtResource("1_voce")
nome = "Inclinazione"
famiglia = 7
forme = PackedStringArray("inclinazione", "inclinazioni")
colore = Color(1, 1, 1, 1)
definizione = "Una delle quattro tendenze della nazione fra due poli: Spada, Porta, Altare, Legge. Le reazioni delle cronache le spostano."

[sub_resource type="Resource" id="voce_n24"]
script = ExtResource("1_voce")
nome = "Tipo"
famiglia = 7
forme = PackedStringArray("tipo", "tipi")
colore = Color(1, 1, 1, 1)
definizione = "Una caratteristica della tessera (es. Fante, Guardiano, Spirituale). Decide quali consiglieri la propongono e la potenziano."
di_base = true

[sub_resource type="Resource" id="voce_n25"]
script = ExtResource("1_voce")
nome = "Categoria"
famiglia = 7
forme = PackedStringArray("categoria", "categorie")
colore = Color(1, 1, 1, 1)
definizione = "Il campo di un consigliere: i tipi di tessere di cui si occupa."

[sub_resource type="Resource" id="voce_n26"]
script = ExtResource("1_voce")
nome = "Capitale"
famiglia = 8
forme = PackedStringArray("Capitale")
colore = Color(0.9412, 0.851, 0.6588, 1)
simbolo = &"tipo_capitale"
definizione = "Il cuore della nazione. Produce Oro, Cibo, Ricerca e una risorsa per ogni elemento dell'identità; nello scontro dà mana energetico. Non si vende e non si sostituisce."

[sub_resource type="Resource" id="voce_n27"]
script = ExtResource("1_voce")
nome = "Spazio"
famiglia = 8
forme = PackedStringArray("spazio", "spazi")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Un posto per una tessera. Se ne ottengono altri con le ere, con certi edifici e con l'Oro."

[sub_resource type="Resource" id="voce_n28"]
script = ExtResource("1_voce")
nome = "Mantenimento"
famiglia = 8
forme = PackedStringArray("mantenimento")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Prima di ogni scontro le tessere potenziate e quelle speciali costano un po' della risorsa del consigliere legato al loro primo tipo."

[sub_resource type="Resource" id="voce_n29"]
script = ExtResource("1_voce")
nome = "Tessera esclusiva"
famiglia = 8
forme = PackedStringArray("tessera esclusiva", "tessere esclusive", "esclusiva", "esclusivo", "esclusive", "esclusivi")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Una tessera che ti viene proposta solo grazie al tuo popolo, governo, credo, cultura o a una via."

[sub_resource type="Resource" id="voce_n30"]
script = ExtResource("1_voce")
nome = "Fantasma"
famiglia = 8
forme = PackedStringArray("fantasma", "fantasmi")
colore = Color(0.9412, 0.851, 0.6588, 1)
simbolo = &"fantasma"
definizione = "La copia registrata della nazione di un altro giocatore: è il nemico di fine anno."

[sub_resource type="Resource" id="voce_n31"]
script = ExtResource("1_voce")
nome = "Incontro del mondo"
famiglia = 8
forme = PackedStringArray("incontro del mondo", "incontri del mondo", "incontro", "incontri")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Una minaccia alla fine della primavera e dell'estate, come barbari o pirati. Ne scegli uno fra tre e affronti la sua plancia. Se perdi, il tuo Oro si dimezza."

[sub_resource type="Resource" id="voce_n32"]
script = ExtResource("1_voce")
nome = "Ricompensa"
famiglia = 8
forme = PackedStringArray("ricompensa", "ricompense")
colore = Color(0.9412, 0.851, 0.6588, 1)
definizione = "Dopo un incontro del mondo vinto, una tessera, una peculiarità, delle risorse o una carta dorata da scegliere; puoi anche non prendere nulla."

