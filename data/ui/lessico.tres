[sub_resource type="Resource" id="voce_45"]
script = ExtResource("1_voce")
nome = "Prestigio"
famiglia = 4
forme = PackedStringArray("prestigio")
colore = Color(0.949, 0.7137, 0.1961, 1)
definizione = "Quanto la tua nazione può ancora permettersi di perdere. Si parte da 20; una sconfitta contro il fantasma ne fa perdere quanto il numero dell'anno. Esaurito, scatta l'ultima possibilità."

[sub_resource type="Resource" id="voce_46"]
script = ExtResource("1_voce")
nome = "Malus"
famiglia = 5
forme = PackedStringArray("malus")
colore = Color(1, 0.3608, 0.4235, 1)
simbolo = &"malus"
definizione = "Un effetto negativo che dura per un certo numero di anni. Non ti rovina: ti spinge a giocare in modo diverso. Se arriva un malus già attivo si allunga solo la durata."

[sub_resource type="Resource" id="voce_47"]
script = ExtResource("1_voce")
nome = "Malcontento"
famiglia = 5
forme = PackedStringArray("malcontento")
colore = Color(1, 0.3608, 0.4235, 1)
simbolo = &"malcontento"
definizione = "La pressione del popolo. Sale con sconfitte, carestie, malus e tessere trascurate; scende soprattutto spendendo Stabilità. Se raggiunge la soglia, scoppia la Rivoluzione."

[sub_resource type="Resource" id="voce_48"]
script = ExtResource("1_voce")
nome = "Rivoluzione"
famiglia = 5
forme = PackedStringArray("rivoluzione")
colore = Color(1, 0.3608, 0.4235, 1)
definizione = "Quando il Malcontento raggiunge la soglia arriva da sola: il popolo cambia governo, anche verso un rango più basso. Poi il Malcontento si azzera."

[sub_resource type="Resource" id="voce_49"]
script = ExtResource("1_voce")
nome = "Affamata"
famiglia = 5
forme = PackedStringArray("affamata", "affamate", "affamato", "affamati")
colore = Color(1, 0.3608, 0.4235, 1)
definizione = "Una truppa rimasta senza razione all'inizio dell'anno: ricarica più lenta (×1,5) fino al pasto dell'anno dopo."
eccezioni = Dictionary[int, String]({8: "Con la tua ascensione Esercito frugale le tue truppe affamate non rallentano."})

