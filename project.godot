; Impostazioni del progetto Ultralopolis (Godot 4.7).

config_version=5

[application]

config/name="Ultralopolis"
config/description="Gioco strategico asincrono: costruisci la nazione, prepara la plancia, affronta i fantasmi."
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/main_menu.tscn"

[autoload]

GameSession="*res://scripts/ui/game_session.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/fallback="it"
